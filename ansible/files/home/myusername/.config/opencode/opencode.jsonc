{
  // keep-sorted start block=yes
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "variant": "high",
    },
  },
  "autoupdate": false,
  "compaction": { "auto": false },
  "instructions": ["AGENTS.md"],
  "mcp": {
    // keep-sorted start block=yes
    "atlassian-mcp-server": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
    },
    "aws-knowledge-mcp-server": {
      "enabled": false,
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
    },
    "aws-mcp": {
      "enabled": false,
      "type": "remote",
      "url": "https://aws-mcp.us-east-1.api.aws/mcp",
    },
    "azure-knowledge": {
      "enabled": false,
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
    },
    "cloudflare-dns-analytics": {
      "enabled": false,
      "type": "remote",
      "url": "https://dns-analytics.mcp.cloudflare.com/sse",
    },
    "context7.com": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "draw.io": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.draw.io/mcp",
    },
    "exa.ai": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
    },
    "exchange-mcp-server": {
      "enabled": false,
      "type": "remote",
      "url": "https://m365-apim.azure-api.net/exch-mcp/mcp",
    },
    "grep.app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
    "playwright-brave": {
      "enabled": false,
      "type": "local",
      // Extension mode against Brave Beta. --executable-path skips the Chrome
      // profile scan; the relay pairs with the running Brave Beta extension.
      "command": [
        "npx",
        "--yes",
        "@playwright/mcp@latest",
        "--extension",
        "--executable-path",
        "/Applications/Brave Browser Beta.app/Contents/MacOS/Brave Browser Beta",
      ],
      "env": {
        // Fill in real token locally; do not commit secrets.
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "",
      },
    },
    "sharepoint-mcp-server": {
      "enabled": false,
      "type": "remote",
      "url": "https://wtw-integration.azure-api.net/sp-mcp/mcp",
    },
    "wiz-integration": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.app.wiz.io",
      "tools": ["*"],
      "headers": {
        // Fill in real credentials locally; do not commit secrets.
        "Wiz-Client-Id": "",
        "Wiz-Client-Secret": "",
        "Wiz-DataCenter": "us8",
        "X-Wiz-MCP-Mode": "gateway",
      },
    },
    "wiz.io": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.app.wiz.io",
      "headers": {
        "X-Wiz-MCP-Mode": "gateway",
      },
    },
    // keep-sorted end
  },
  "model": "github-copilot/claude-opus-4.8",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "webfetch": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "/var/folders/**": "allow",
    },
  },
  "plugin": [
    [
      "opencode-ascii",
      {
        "emojis": false,
      },
    ],
    "opencode-claude-auth@latest",
    "@mohak34/opencode-notifier@latest",
    //"oh-my-opencode@latest"
    //"opencode-copilot-budget"
    //"superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "share": "disabled",
  // keep-sorted end
}
